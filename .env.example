# Glanceboard container settings — copy to `.env` and edit.
#
#   cp .env.example .env
#
# Every value below has a working default baked into docker-compose.yml, so
# `docker compose up` runs without a .env at all. Set these only to override.
# `.env` is gitignored; this file is not. Keep real values out of it.

# Host port to publish the dashboard on. The container always listens on 8000
# internally — this is the port you open in a browser.
# On Synology DSM, avoid 5000/5001 (used by DSM itself); 8000 is often taken too.
GLANCEBOARD_PORT=8000

# Container clock. Match this to the timezone you pick in the dashboard —
# generation is scheduled at specific hours, so a mismatch shows up as images
# arriving at the wrong time of day.
TZ=UTC

# User the container process runs as. Defaults to root (0:0), which works
# everywhere without preparation.
#
# To run unprivileged instead, set both to a real account (find yours with
# `id <username>`) AND chown the data folder to that uid:gid BEFORE the first
# start. app.py creates data/images and data/uploads at import time, so if the
# container has ever started as root those end up root-owned; a later non-root
# start can read but not write them, and character photo uploads fail with a
# 500. Switching after first start requires re-running the chown.
PUID=0
PGID=0
